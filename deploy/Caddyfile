{$DOMAIN} {
	# O Actuator (health, prometheus) não deve ser acessível de fora.
	# Se um monitor externo precisar do health, troque por: path /actuator/prometheus /actuator/env ...
	@actuator path /actuator /actuator/*
	respond @actuator 404

	reverse_proxy app:8080

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		-Server
	}
}

# www redireciona para o domínio principal (o CNAME www já existe no DNS)
www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}

# Front estático (quando existir): descomente, ajuste o root e adicione o registro A "app" no DNS.
