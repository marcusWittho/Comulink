# Copie para .env no servidor (chmod 600). NUNCA commitar o .env real.

# Domínio apontado (registro A) para o IP do VPS
DOMAIN=wittho.com

# Imagem publicada pelo CI no GHCR: ghcr.io/<dono em minúsculas>/<nome do repositório em minúsculas>
IMAGE_REPO=ghcr.io/marcuswittho/comulink
IMAGE_TAG=0.0.1

# Supabase via pooler em modo sessão (porta 5432): funciona com IPv4 e com o pool do Hikari.
# Evite a porta 6543 (modo transação): quebra prepared statements do driver JDBC.
# O usuário do pooler tem o formato <role>.<project-ref> (project-ref está na URL do painel do Supabase).
DATABASE_URL=jdbc:postgresql://aws-0-us-east-1.pooler.supabase.com:5432/postgres?sslmode=require
DATABASE_USERNAME=postgres.SEU_PROJECT_REF
DATABASE_PASSWORD=troque-por-uma-senha-forte

# Só o Caddy alcança a aplicação, então confiar em X-Forwarded-* é seguro (rate limit usa o IP real)
SERVER_FORWARD_HEADERS_STRATEGY=native
